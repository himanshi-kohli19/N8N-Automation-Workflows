    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let raw = item.json.output;\n\n  // Clean JSON wrappers\n  raw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n\n  let parsed;\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    const match = raw.match(/\\{[\\s\\S]*\\}/);\n    if (match) parsed = JSON.parse(match[0]);\n    else throw new Error(\"Invalid JSON\");\n  }\n\n  const clean = (text) =>\n    String(text || \"\")\n      .replace(/\\*\\*/g, '')\n      .replace(/__/g, '')\n      .replace(/`/g, '')\n      .replace(/\\r/g, '')\n      .trim();\n\n  // 🔥 Convert AI text → structured HTML\n  const formatContent = (text) => {\n    const cleaned = clean(text);\n\n    const lines = cleaned.split('\\n');\n\n    let html = '';\n    let listBuffer = [];\n\n    const flushList = () => {\n      if (listBuffer.length) {\n        html += `<ul style=\"padding-left:18px; margin:0 0 16px;\">`;\n        listBuffer.forEach(item => {\n          html += `<li style=\"margin-bottom:8px;\">${item}</li>`;\n        });\n        html += `</ul>`;\n        listBuffer = [];\n      }\n    };\n\n    lines.forEach(line => {\n      const l = line.trim();\n\n      // Detect bullets (•, -, 1.)\n      if (/^(•|-|\\d+\\.)\\s/.test(l)) {\n        listBuffer.push(l.replace(/^(•|-|\\d+\\.)\\s/, ''));\n      } else if (l === '') {\n        flushList();\n      } else {\n        flushList();\n\n        // Highlight numbers like 60%, 30%, 20-minute\n        const highlighted = l\n          .replace(/(\\d+%)/g, '<strong>$1</strong>')\n          .replace(/(\\d+-minute)/g, '<strong>$1</strong>');\n\n        html += `<p style=\"margin:0 0 14px;\">${highlighted}</p>`;\n      }\n    });\n\n    flushList();\n\n    return html;\n  };\n\n  const buildHTML = (message) => {\n    return `\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f9fafb; padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n\n          <table width=\"520\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff; border-radius:8px; padding:24px;\">\n            <tr>\n              <td style=\"font-family: Arial, sans-serif; font-size:15px; line-height:1.7; color:#1a1a1a;\">\n                \n                ${formatContent(message)}\n\n                <p style=\"margin-top:20px;\">\n                  Best regards,<br>\n                  <strong>XYZ Company Team</strong>\n                </p>\n\n              </td>\n            </tr>\n          </table>\n\n        </td>\n      </tr>\n    </table>\n    `;\n  };\n\n  return {\n    json: {\n      subject: clean(parsed.Subject),\n      message: buildHTML(parsed.Message)\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
