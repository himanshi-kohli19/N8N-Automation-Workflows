        "jsCode": "const thread = $json.messages;\n\nconst MY_EMAIL = \"himanshi.kohli19@gmail.com\";\n\n// Filter only client messages\nconst clientMessages = thread.filter(msg => {\n  return !msg.From.includes(MY_EMAIL);\n});\n\n// Sort by latest\nclientMessages.sort((a, b) => {\n  return Number(b.internalDate) - Number(a.internalDate);\n});\n\n// Pick latest client message\nconst latest = clientMessages[0];\n\nreturn [\n  {\n    json: {\n      messageId: latest.id\n    }\n  }\n];"
