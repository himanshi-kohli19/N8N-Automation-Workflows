    {
      "parameters": {
        "functionCode": "// Cross-validate CRM and DRE expiration dates and JoinReal state.\nconst crm = $('1 -> API: extract agent metadata').item.json;\nconst jr = $('2 -> Worker: JoinReal verify').item.json;\nconst dre = $('3 -> Worker: DRE verify (per-state)').item.json;\n\nconst result = {\n  agent_id: crm.id,\n  state_match: jr.listed_state === crm.licensing_state,\n  expiration_match: crm.license_expiration === dre.expiration,\n  crm_expiration: crm.license_expiration,\n  dre_expiration: dre.expiration,\n  joinreal_state: jr.listed_state,\n  crm_state: crm.licensing_state,\n  joinreal_found: jr.found === true\n};\n\nresult.verified = result.state_match && result.expiration_match && result.joinreal_found;\nresult.failure_reason = !result.verified\n  ? (!result.joinreal_found ? 'not_found_on_joinreal'\n    : !result.state_match ? 'state_mismatch'\n    : !result.expiration_match ? 'expiration_mismatch'\n    : 'unknown')\n  : null;\n\nreturn { json: result };"
      },
