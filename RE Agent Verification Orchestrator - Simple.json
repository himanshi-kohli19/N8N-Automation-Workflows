        "functionCode": "// Verify HMAC signature on raw body using shared secret from credential.\nconst crypto = require('crypto');\nconst secret = $env.CRM_WEBHOOK_HMAC_SECRET;\nconst signature = $input.item.json.headers['x-real-signature'];\nconst raw = $input.item.json.rawBody;\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nif (signature !== expected) {\n  throw new Error('Invalid HMAC signature');\n}\nreturn { json: JSON.parse(raw) };"
      },
