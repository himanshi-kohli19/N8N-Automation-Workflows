      "parameters": {
        "jsCode": "const err = $json.execution.error || {};\nconst msg = (err.message || '').toLowerCase();\nconst stepName = err.node && err.node.name ? err.node.name : '';\nlet cls = 'poison';\nif (msg.includes('timeout') || msg.includes('econnreset') || msg.includes('5xx')) cls = 'transient';\nelse if (msg.includes('selector') || msg.includes('locator')) cls = 'selector';\nelse if (msg.includes('data_mismatch') || msg.includes('mismatch')) cls = 'data_mismatch';\nelse if (msg.includes('not_found') || msg.includes('zero results')) cls = 'not_found';\n// Unwrap structured error payload if present\nlet payload = {};\ntry { payload = JSON.parse(err.message); cls = payload.failure_class || cls; } catch (e) {}\nreturn [{ json: { failure_class: cls, step: stepName, raw: err.message, payload, run_id: payload.run_id } }];"
